{
  "name": "dse-pulse-pipeline",
  "version": "1.0.0",
  "description": "DSEPulse Data Ingestion, Scraping, 20-Year Historical Audit & Test Engine",
  "type": "module",
  "main": "src/scheduler.js",
  "scripts": {
    "start":               "node src/cli.js --help",
    "cli":                 "node src/cli.js",

    "db:init":             "node src/cli.js --init-db",

    "fetch:companies":     "node src/cli.js --fetch-company-list",
    "fetch:companies:full":"node src/cli.js --fetch-company-list --details",

    "import:prices":       "node src/cli.js --import-prices",
    "import:index":        "node src/cli.js --import-index",

    "scrape:gap":          "node src/cli.js --scrape-gap",
    "scrape:fundamentals": "node src/cli.js --scrape-fundamentals",

    "compute:all":         "node src/cli.js --compute-all",
    "compute:technical":   "node src/cli.js --compute-technical",
    "compute:performance": "node src/cli.js --compute-performance",
    "compute:fundamentals":"node src/cli.js --compute-fundamentals",

    "build:full":          "node src/cli.js --build-full",
    "resume":              "node src/cli.js --resume",

    "audit":               "node src/cli.js --audit",
    "test":                "node src/audit/test_suite.js",
    "report":              "node src/cli.js --report",
    "promote:main":        "node src/cli.js --promote-main"
  },
  "keywords": [
    "dse",
    "data-pipeline",
    "historical-builder",
    "financial-audit",
    "staging-db"
  ],
  "author": "Iftekhar Anam",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "fs-extra": "^11.3.0",
    "node-cron": "^3.0.3",
    "sqlite3": "^6.0.1"
  }
}
