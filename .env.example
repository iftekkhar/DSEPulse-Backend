# DSEPulse Backend (server/) Environment Configuration
# INGEST_API_KEY must match the value in pipeline/.env exactly -- it's how the
# pipeline authenticates to POST /api/ingest/live. The server refuses to boot
# if this is unset (see server/index.js).
INGEST_API_KEY=replace-with-a-long-random-secret-shared-with-pipeline/.env

# Premium tier (added 2026-08-23) -- see server/auth.js / server/entitlements.js
# Google Cloud Console OAuth 2.0 Client ID (Web application type). Used to
# verify Google Sign-In ID tokens server-side; POST /api/auth/google refuses
# every request until this is set.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id

# Comma-separated list of emails allowed into the admin panel
# (requireAdminAuth in server/auth.js). Case-insensitive.
ADMIN_EMAILS=iftekhar.anam8@gmail.com

# Comma-separated list of frontend origins allowed to make credentialed
# (cookie-carrying) requests -- CORS forbids combining credentials with a
# wildcard origin, so this replaces the old origin: '*'. localhost dev ports
# are always allowed regardless of this value.
FRONTEND_ORIGINS=https://dse-frontend-m82u.onrender.com

# Payments (SSLCommerz, added 2026-08-23) -- see server/payments.js
# Sandbox merchant credentials from https://developer.sslcommerz.com/registration/
# SSLCOMMERZ_IS_LIVE=true switches the base URL to the production gateway --
# leave unset/false until going live with real production credentials.
SSLCOMMERZ_STORE_ID=replace-with-your-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=replace-with-your-sslcommerz-store-password
SSLCOMMERZ_IS_LIVE=false

# Used to build SSLCommerz's success/fail/cancel/ipn callback URLs and the
# post-payment frontend redirect -- must be reachable from the internet for
# SSLCommerz's IPN to work (not localhost) once deployed.
BACKEND_BASE_URL=http://localhost:5001
FRONTEND_PAYMENT_RESULT_URL=http://localhost:5173/payments/result
