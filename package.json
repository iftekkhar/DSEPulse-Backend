{
  "name": "dse-pulse-backend",
  "version": "1.0.0",
  "description": "DSE Pulse Institutional Backend Engine & SQLite Database Server (Dhaka UTC+6)",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "scrape:current": "node server/scrapers/scrape_current_daily_operations.js",
    "scrape:closing": "node server/scrapers/scrape_current_daily_operations.js --closing",
    "scrape:daily-delta": "node server/scrapers/scrape_current_daily_operations.js --eps",
    "scrape:company-roster": "node server/scrapers/scrape_current_daily_operations.js --roster",
    "scrape:ds30": "node server/scrapers/scrape_current_daily_operations.js --ds30",
    "scrape:live-ticker": "node server/scrapers/scrape_live_intraday_ticker.js",
    "scrape:gaps": "node server/scrapers/scrape_current_gap_filler_operations.js",
    "scrape:fundamentals": "node server/scrapers/scrape_historical_financial_statements.js",
    "scrape:historical-indexes": "node server/scrapers/scrape_historical_indexes.js",
    "scrape:lankabd": "node server/scrapers/scrape_historical_lankabd_prices.js",
    "audit:main-db": "node server/auditors/audit_main_database.js",
    "audit:code": "node shared/code_audit.js",
    "audit:prices:dse": "node server/auditors/audit_historical_prices_dse.js",
    "audit:fundamentals:dse": "node server/auditors/audit_historical_fundamentals_dse.js",
    "audit:index:dse": "node server/auditors/audit_historical_dsex_index.js",
    "audit:company-roster:dse": "node server/auditors/audit_company_roster_dse.js",
    "audit:prices:lankabd": "node server/auditors/audit_historical_prices_lankabd.js",
    "audit:samples": "node server/auditors/audit_sample_stocks.js",
    "audit:quarantine": "node server/auditors/audit_quarantine.js",
    "audit:gaps": "node server/auditors/audit_data_gaps.js",
    "audit:block-market": "node server/auditors/audit_block_market.js",
    "audit:credit-ratings": "node server/auditors/audit_credit_ratings.js",
    "audit:share-lockins": "node server/auditors/audit_share_lockins.js",
    "audit:pdf-statements": "node server/auditors/audit_pdf_financial_statements.js",
    "audit:frontend-api": "node server/auditors/audit_frontend_api_consistency.js",
    "audit:crosscheck:all": "npm run audit:company-roster:dse; npm run audit:prices:dse; npm run audit:fundamentals:dse; npm run audit:index:dse; npm run audit:prices:lankabd",
    "audit:all": "npm run audit:code && node server/auditors/audit_main_database.js --skip-live",
    "audit:full": "npm run audit:all && npm run audit:crosscheck:all; npm run audit:gaps; npm run audit:quarantine; npm run audit:samples; npm run audit:block-market; npm run audit:credit-ratings; npm run audit:share-lockins; npm run audit:pdf-statements",
    "test": "node shared/test_suite.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "fs-extra": "^11.4.0",
    "google-auth-library": "^10.9.1",
    "node-cron": "^4.6.0",
    "sharp": "^0.35.3",
    "sqlite3": "^6.0.1"
  }
}
