{
  "name": "dse-pulse-backend",
  "version": "1.0.0",
  "description": "DSE Pulse Institutional Backend Engine & SQLite Database Server (Dhaka UTC+6)",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "resume": "npm --prefix pipeline run resume",
    "build:full": "npm --prefix pipeline run build:full",
    "pipeline": "npm --prefix pipeline start",
    "pipeline:audit": "npm --prefix pipeline run audit",
    "pipeline:report": "npm --prefix pipeline run report",
    "scrape:audited": "node server/scrapers/audited_eps_scraper.js",
    "audit:main-db": "node server/audit/db_auditor.js",
    "audit:code": "node shared/code_audit.js",
    "audit:all": "npm run audit:code && npm run pipeline:audit && npm run audit:main-db",
    "test": "node shared/test_suite.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "fs-extra": "^11.4.0",
    "google-auth-library": "^10.9.1",
    "node-cron": "^4.6.0",
    "sharp": "^0.35.3",
    "sqlite3": "^6.0.1"
  }
}
