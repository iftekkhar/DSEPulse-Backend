# Dependencies
node_modules/

# OS Files
.DS_Store
Thumbs.db

# Environment variables & secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SQLite Database & Cache files (including timestamped safety backups, e.g. dse.db.bak-20260822-103449)
*.db
*.db-shm
*.db-wal
*.db.bak-*
*.db.bak-*-shm
*.db.bak-*-wal
*.sqlite
*.sqlite3

# Temporary Excel/Data dumps
*.xlsx
*.csv

# Raw source dataset dumps (Kaggle/Mendeley/etc.) and local staging working data
pipeline/data/

# Generated runtime data snapshots (not source) -- latest.json is a live
# zero-fail fallback rewritten on every scrape, history.json/missing_report.json
# are dead artifacts of an older flat-file design. Keep data/.gitkeep so the
# directory still exists on a fresh clone.
data/*.json

# Claude Code local tool state
.claude/

.playwright-mcp/
